# Paper.id MCP Server — Environment Variables
# Copy to .env and fill in your credentials. Never commit .env.

# Required for auto token refresh on 401
PAPERID_PHONE=08xxxxxxxxxx
PAPERID_PASSWORD=your_password_here

# Optional: pre-set JWT token (takes precedence over SQLite; use for one-time setups)
# PAPERID_TOKEN=

# Optional: override company/user IDs (auto-loaded from SQLite if login was run)
# PAPERID_COMPANY_ID=
# PAPERID_USER_ID=

# Optional: custom SQLite database path (default: ~/.paperid-mcp/tokens.db)
# PAPERID_DB_PATH=/path/to/tokens.db
